{
  "name": "@bill-and-go/acleda",
  "version": "0.1.0",
  "description": "ACLEDA ToanChet Pay (XPAY) for Node: open a KHQR payment (as a string or an image), check it, refund, and the hash ACLEDA checks. No framework.",
  "license": "MIT",
  "author": "bill&go",
  "repository": { "type": "git", "url": "git+https://github.com/Bill-and-Go/acleda-js.git" },
  "bugs": { "url": "https://github.com/Bill-and-Go/acleda-js/issues" },
  "homepage": "https://github.com/Bill-and-Go/acleda-js",
  "keywords": ["acleda", "acleda-bank", "toanchet", "xpay", "khqr", "cambodia", "payments"],
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build-dual.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "node build-dual.mjs"
  },
  "dependencies": {
    "@bill-and-go/khqr": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
